[
    {
        "request": "launch",
        "adapter": "CodeLLDB",
        "label": "Debug ENVCMD",
        "cwd": "$ZED_WORKTREE_ROOT",
        "program": "$ZED_WORKTREE_ROOT/bin/envcmd-debug",
        "build": {
            "command": "odin",
            "cwd": "$ZED_WORKTREE_ROOT",
            "args": [
                "build",
                ".",
                "-debug",
                "-o:none",
                "-out:$ZED_WORKTREE_ROOT/bin/envcmd-debug",
            ],
        },
        "env": {
            "EVC_CMD_SEP": "||||",
            "EVC_DIR_ENVCMD": "echo 'foo' |||| echo 'bar'",
            "EVC_BRA_MAIN": "echo 'foobar' |||| echo 'barfoo'",
        },
    },
]
