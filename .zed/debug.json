[
    {
        "request": "launch",
        "adapter": "CodeLLDB",
        "label": "Debug ENVCMD",
        "cwd": "$ZED_WORKTREE_ROOT",
        "program": "$ZED_WORKTREE_ROOT/bin/envcmd-debug",
        "env": {
            "EVC_DIR_ENVCMD": "echo 'foo' ||| echo 'bar'",
            "EVC_BRA_MAIN": "echo 'bar' ||| echo 'foo'",
            "EVC_ALL_ENVCMD__MAIN": "echo 'foobar' ||| echo 'barfoo'",
            "EVC_FOO": "echo 'impossible'",
            "EVC_DIR_": "echo 'impossible'",
            "EVC_BRA_": "echo 'impossible'",
            "EVC_ALL_": "echo 'impossible'",
            "EVC_ALL_ENVCMD": "echo 'impossible'",
        },
        "build": {
            "command": "odin",
            "cwd": "$ZED_WORKTREE_ROOT",
            "args": [
                "build",
                ".",
                "-debug",
                "-o:none",
                "-out:$ZED_WORKTREE_ROOT/bin/envcmd-debug",
            ],
        },
    },
]
